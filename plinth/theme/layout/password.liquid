<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="type-{{ settings.type_personality }}">
    <main style="min-height:100vh; display:grid; place-items:center; padding: var(--s-6)">
      {{ content_for_layout }}
    </main>
  </body>
</html>
