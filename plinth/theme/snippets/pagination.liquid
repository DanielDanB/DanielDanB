{%- comment -%}
  Numbered pagination, used when the merchant prefers pages to load-more.
  Accepts: paginate
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
        {%- render 'icon', name: 'chevron-left', size: 14 -%}
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="pagination__link" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
      {%- elsif part.title == '&hellip;' -%}
        <span class="pagination__link" aria-hidden="true">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__link" aria-current="page">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
        {%- render 'icon', name: 'chevron-right', size: 14 -%}
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
