{%- comment -%}
  Inline icon set. One snippet, no sprite request, no icon font.

  Usage: {% render 'icon', name: 'cart', size: 20 %}
  All icons share a 24×24 box and a 1.4 stroke so they sit on the same
  optical weight as the interface type.
{%- endcomment -%}

{%- liquid
  assign size = size | default: 20
  assign classes = class | default: ''
-%}

{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M4.5 7.5h15l-1.2 12.2a1 1 0 0 1-1 .8H6.7a1 1 0 0 1-1-.8L4.5 7.5Z" stroke-linejoin="round"/><path d="M9 9.5V6a3 3 0 0 1 6 0v3.5" stroke-linecap="round"/></svg>
  {%- when 'user' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.75"/><path d="M4.75 20.25a7.25 7.25 0 0 1 14.5 0" stroke-linecap="round"/></svg>
  {%- when 'heart' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M12 20.2 4.9 13.4a4.4 4.4 0 0 1 6.2-6.2l.9.9.9-.9a4.4 4.4 0 0 1 6.2 6.2L12 20.2Z" stroke-linejoin="round"/></svg>
  {%- when 'menu' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3.5 7.5h17M3.5 12h17M3.5 16.5h17" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m5 9 7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m15 4-7 8 7 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m9 4 7 8-7 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
