  {%- when 'return' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 1 1 2.6 5.9" stroke-linecap="round"/><path d="M3.5 7.5v4.2h4.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M12 3.2 5 5.9v5.4c0 4.2 2.8 7.6 7 9.5 4.2-1.9 7-5.3 7-9.5V5.9L12 3.2Z" stroke-linejoin="round"/><path d="m9 12 2.2 2.2L15.5 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'gift' -%}
    <svg class="icon {{ classes }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3.75 8.75h16.5v3.5H3.75zM5.25 12.25h13.5v8H5.25zM12 8.75v11.5"/><path d="M12 8.75S10.5 4 8.25 4a2 2 0 0 0 0 4.75M12 8.75S13.5 4 15.75 4a2 2 0 0 1 0 4.75" stroke-linecap="round"/></svg>
  {%- when 'leaf' -%}
