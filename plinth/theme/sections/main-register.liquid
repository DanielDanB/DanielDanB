<div class="page-wrap auth-layout">
  <div class="auth-card">
    <h1 class="h3">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'stack' -%}
      {{ form.errors | default_errors }}
      <label class="field">
        <input class="field__input" type="text" name="customer[first_name]" placeholder=" " autocomplete="given-name">
        <span class="field__label">{{ 'customer.register.first_name' | t }}</span>
      </label>
      <label class="field">
        <input class="field__input" type="text" name="customer[last_name]" placeholder=" " autocomplete="family-name">
        <span class="field__label">{{ 'customer.register.last_name' | t }}</span>
      </label>
      <label class="field">
        <input class="field__input" type="email" name="customer[email]" placeholder=" " autocomplete="email" required>
        <span class="field__label">{{ 'customer.register.email' | t }}</span>
      </label>
      <label class="field">
        <input class="field__input" type="password" name="customer[password]" placeholder=" " autocomplete="new-password" required>
        <span class="field__label">{{ 'customer.register.password' | t }}</span>
      </label>
      <button type="submit" class="btn btn--primary btn--full"><span>{{ 'customer.register.submit' | t }}</span></button>
      <a class="link text-sm" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
