{%- comment -%}
  Newsletter seam. Subscribers are created as Shopify customers tagged
  "newsletter", ready for Shopify Email or any connected marketing app.
{%- endcomment -%}

<section class="section{% if section.settings.sunken %} section--sunken{% endif %}">
  <div class="page-wrap">
    <div class="newsletter">
      <div class="newsletter__body reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label label--accent">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="text-muted">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- render 'newsletter-form',
          id: 'section-newsletter',
          button_label: section.settings.button_label,
          note: section.settings.note
        -%}
      </div>

      <div class="newsletter__media reveal-media">
        {%- if section.settings.image != blank -%}
          <div class="media">
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First look, twice a month" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "New arrivals, restocks and the occasional studio note. No noise."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Unsubscribe any time." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "sunken", "label": "Sunken background", "default": false }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
