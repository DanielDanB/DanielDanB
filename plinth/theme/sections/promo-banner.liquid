{%- comment -%}
  Full-bleed promotional band. Deliberately spare: one image, one line, one
  action. The optional ledger row carries offer details without turning the
  section into a poster.
{%- endcomment -%}

<section class="promo">
  <div class="promo__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
        loading="lazy"
        decoding="async"
        {% if section.settings.parallax %}data-parallax="5"{% endif %}
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="promo__body reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="label">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lede">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--accent" href="{{ section.settings.button_url }}"><span>{{ section.settings.button_label }}</span></a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="promo__ledger">
        {%- for block in section.blocks -%}
          <div class="promo__ledger-item" {{ block.shopify_attributes }}>
            <span class="promo__ledger-value">{{ block.settings.value }}</span>
            <span class="label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Promotional banner",
  "class": "section-promo",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited release" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The winter capsule" },
    { "type": "text", "id": "text", "label": "Text", "default": "Forty pieces. Once they are gone, they are gone." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the capsule" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "parallax", "label": "Subtle parallax", "default": true }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "40" },
        { "type": "text", "id": "label", "label": "Label", "default": "Pieces" }
      ]
    }
  ],
  "presets": [{ "name": "Promotional banner" }]
}
{% endschema %}
