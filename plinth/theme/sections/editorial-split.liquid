{%- comment -%}
  Brand story: image with an overlapping inset, a short passage and up to
  three figures. This is where a small brand earns the price it is asking.
{%- endcomment -%}

<section class="section{% if section.settings.sunken %} section--sunken{% endif %}">
  <div class="page-wrap">
    <div class="editorial{% if section.settings.reverse %} editorial--reverse{% endif %}">
      <div class="editorial__media reveal">
        <div class="media reveal-media">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 45vw, 100vw"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.inset_image != blank -%}
          <div class="editorial__inset">
            <div class="media">
              <img
                src="{{ section.settings.inset_image | image_url: width: 600 }}"
                width="{{ section.settings.inset_image.width }}"
                height="{{ section.settings.inset_image.height }}"
                alt=""
                loading="lazy"
                decoding="async"
              >
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="editorial__body reveal" style="--reveal-delay: 90ms">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label label--accent">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>

        {%- if section.settings.button_label != blank -%}
          <div>
            <a class="btn btn--secondary" href="{{ section.settings.button_url }}"><span>{{ section.settings.button_label }}</span></a>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="editorial__stats">
            {%- for block in section.blocks -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <span class="stat__value tabular">{{ block.settings.value }}</span>
                <span class="label stat__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "class": "section-editorial",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "inset_image", "label": "Inset image", "info": "Overlaps the main image on desktop." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made slowly, on purpose" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We work with a handful of makers and keep our runs small. It means we sell out sometimes, and it means every piece leaves the studio checked by someone who knows what it should feel like.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "sunken", "label": "Sunken background", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "12" },
        { "type": "text", "id": "label", "label": "Label", "default": "Makers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "stat", "settings": { "value": "12", "label": "Makers" } },
        { "type": "stat", "settings": { "value": "4.9", "label": "Average rating" } },
        { "type": "stat", "settings": { "value": "30", "label": "Day returns" } }
      ]
    }
  ]
}
{% endschema %}
