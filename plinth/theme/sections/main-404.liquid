<div class="page-wrap section" style="display:grid; place-items:center; text-align:center; min-height:52vh">
  <div class="stack" style="max-width: 46ch">
    <span class="label label--accent">404</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="text-muted">{{ section.settings.text }}</p>
    <div class="cluster" style="justify-content:center">
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}"><span>{{ section.settings.button_label }}</span></a>
      <button type="button" class="btn btn--secondary" data-dialog-open="search"><span>{{ 'search.general.title' | t }}</span></button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has moved on" },
    { "type": "text", "id": "text", "label": "Text", "default": "The link may be old, or the piece may have sold out. Everything current is one click away." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop everything" }
  ]
}
{% endschema %}
