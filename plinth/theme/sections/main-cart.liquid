{%- comment -%}
  Cart page. Shopify owns the totals, discounts and checkout; this page
  presents them and gets out of the way.
{%- endcomment -%}

<div class="page-wrap" data-cart-section="{{ section.id }}">
  {%- if cart.item_count == 0 -%}
    <div class="cart-drawer__empty">
      <h1 class="h2">{{ 'cart.general.empty' | t }}</h1>
      <p class="text-muted">{{ 'cart.general.empty_body' | t }}</p>
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
        <span>{{ 'cart.general.continue_shopping' | t }}</span>
      </a>
    </div>
  {%- else -%}
    <div class="cart-page">
      <div>
        <h1 class="h2" style="margin-bottom: var(--s-5)">{{ 'cart.general.title' | t }}</h1>

        <form action="{{ routes.cart_url }}" method="post" novalidate>
          <cart-items class="cart-table">
            {%- for item in cart.items -%}
              {%- render 'cart-item', item: item, layout: 'page' -%}
            {%- endfor -%}
          </cart-items>
        </form>

        {%- if settings.cart_notes -%}
          <cart-note style="display:block; margin-top: var(--s-6)">
            <label class="field">
              <textarea class="field__input" name="note" placeholder=" ">{{ cart.note }}</textarea>
              <span class="field__label">{{ 'cart.general.note' | t }}</span>
            </label>
          </cart-note>
        {%- endif -%}
      </div>

      <aside class="cart-summary">
        {%- render 'shipping-meter' -%}

        <div class="cart-summary__row">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span class="tabular">{{ cart.total_price | money }}</span>
        </div>

        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-summary__row text-accent">
            <span>{{ discount.title }}</span>
            <span class="tabular">−{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}

        <div class="rule"></div>

        <div class="cart-summary__row">
          <span class="cart-summary__total">{{ 'cart.general.subtotal' | t }}</span>
          <span class="cart-summary__total tabular">{{ cart.total_price | money }}</span>
        </div>

        <p class="text-sm text-muted">{{ 'cart.general.taxes_and_shipping' | t }}</p>

        <form action="{{ routes.cart_url }}" method="post" novalidate>
          <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg">
            <span>{{ 'cart.general.checkout' | t }}</span>
          </button>
        </form>

        {%- if settings.cart_reassurance != blank -%}
          <div class="rte text-sm text-center">{{ settings.cart_reassurance }}</div>
        {%- endif -%}
      </aside>
    </div>

    {%- if settings.cart_recommendations -%}
      <section class="section section--tight">
        {%- assign recs_heading = 'cart.general.recommendations' | t -%}
        {%- render 'section-head', index: '01', eyebrow: recs_heading, heading: recs_heading -%}
        <div class="ledger ledger--4">
          {%- assign rec_collection = collections.all -%}
          {%- for product in rec_collection.products limit: 4 -%}
            <div>{%- render 'product-card', product: product -%}</div>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "class": "section-cart",
  "settings": []
}
{% endschema %}
