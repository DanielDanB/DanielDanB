{%- comment -%}
  Product recommendations from Shopify's recommendation engine, which learns
  from real order history rather than from a hand-built list.
{%- endcomment -%}

{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="section section--tight">
    <div class="page-wrap">
      {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
      <div class="ledger ledger--4">
        {%- for product in recommendations.products limit: section.settings.count -%}
          <div class="reveal">{%- render 'product-card', product: product -%}</div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- else -%}
  {%- comment -%} Fetched lazily so it never blocks the product page render. {%- endcomment -%}
  <div
    class="page-wrap"
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
  ></div>

  <script>
    (function () {
      var host = document.querySelector('[data-recommendations]');
      if (!host) return;
      fetch(host.dataset.url)
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var section = new DOMParser().parseFromString(html, 'text/html').querySelector('.section');
          if (section) { host.replaceWith(section); window.Plinth && window.Plinth.initReveal(); }
        })
        .catch(function () { host.remove(); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recommended" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "count", "min": 2, "max": 8, "step": 1, "label": "Products shown", "default": 4 }
  ]
}
{% endschema %}
