{%- comment -%}
  Hero — the seam.

  Two unequal panes with the headline crossing the join. Merchants can switch
  to a full-bleed image with the text laid over it, which suits photography-led
  brands better than the split.
{%- endcomment -%}

{%- liquid
  assign layout = section.settings.layout
  assign hero_class = 'hero'
  if layout == 'split'
    assign hero_class = 'hero hero--seam hero--split-40'
  else
    assign hero_class = 'hero hero--full hero--overlay-dark'
  endif
-%}

<section class="{{ hero_class }}" {% if section.settings.text_light %}style="color: var(--c-on-primary)"{% endif %}>
  {%- if layout == 'split' -%}
    <div class="hero__pane">
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label label--accent reveal">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="hero__title reveal" style="--reveal-delay: 60ms">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="hero__body reveal" style="--reveal-delay: 120ms">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hero__actions reveal" style="--reveal-delay: 180ms">
            <a class="btn btn--primary" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
              <span>{{ section.settings.button_label }}</span>
            </a>
            {%- if section.settings.button_label_2 != blank -%}
              <a class="btn btn--secondary" href="{{ section.settings.button_url_2 }}">
                <span>{{ section.settings.button_label_2 }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="hero__media reveal-media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w,
          {{ section.settings.image | image_url: width: 2400 }} 2400w
        "
        sizes="{% if layout == 'split' %}(min-width: 990px) 58vw, 100vw{% else %}100vw{% endif %}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
        fetchpriority="high"
        {% if section.settings.parallax %}data-parallax="6"{% endif %}
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if layout == 'full' -%}
    <div class="hero__pane">
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label reveal">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="h-display reveal" style="--reveal-delay: 60ms">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="hero__body reveal" style="--reveal-delay: 120ms">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hero__actions reveal" style="--reveal-delay: 180ms">
            <a class="btn btn--primary" href="{{ section.settings.button_url }}"><span>{{ section.settings.button_label }}</span></a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="hero__rail">
      {%- for block in section.blocks -%}
        <span class="hero__rail-item label" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon, size: 14 -%}{%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split — text beside image" },
        { "value": "full", "label": "Full bleed — text over image" }
      ],
      "default": "split"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Replaces the image. Plays muted and looped." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn release" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Objects worth keeping" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A small collection, made in limited runs, finished by hand."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_url_2", "label": "Second button link" },
    { "type": "checkbox", "id": "parallax", "label": "Subtle parallax", "default": true },
    { "type": "checkbox", "id": "text_light", "label": "Light text", "default": false }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Rail note",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over 150" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Secure" },
            { "value": "leaf", "label": "Sustainable" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
