{%- comment -%}
  Header: logo, primary navigation with mega menus, search, account, wishlist
  and cart. Navigation comes from a Shopify menu, so merchants restructure the
  store from Navigation rather than from code.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign overlay = false
  if section.settings.transparent_home and template.name == 'index'
    assign overlay = true
  endif
-%}

<site-header
  class="header-wrap{% if overlay %} header-wrap--overlay{% endif %}"
  {% if section.settings.sticky == false %}style="position: relative;"{% endif %}
>
  <header class="header{% if section.settings.logo_position == 'left' %} header--left{% endif %}">
    <div class="header__inner">
      {%- comment -%} Left: navigation on desktop, menu button on mobile. {%- endcomment -%}
      <div class="header__nav">
        <button
          type="button"
          class="icon-btn hide-desktop"
          data-dialog-open="mobile-menu"
          aria-label="{{ 'general.accessibility.open_menu' | t }}"
        >
          {%- render 'icon', name: 'menu', size: 20 -%}
        </button>

        <nav class="nav hide-mobile" aria-label="{{ 'sections.header.menu' | t }}">
          {%- for link in menu.links -%}
            {%- liquid
              assign has_children = false
              if link.links.size > 0
                assign has_children = true
              endif

              assign is_mega = false
              for child in link.links
                if child.links.size > 0
                  assign is_mega = true
                endif
              endfor

              assign feature_image = null
              assign feature_heading = ''
              assign feature_text = ''
              assign feature_url = ''
              for block in section.blocks
                if block.type == 'mega_feature' and block.settings.menu_title == link.title
                  assign feature_image = block.settings.image
                  assign feature_heading = block.settings.heading
                  assign feature_text = block.settings.text
                  assign feature_url = block.settings.url
                endif
              endfor
            -%}

            <div class="nav__item" {% if has_children %}data-menu{% endif %}>
              {%- if has_children -%}
                <button
                  type="button"
                  class="nav__link{% if link.active or link.child_active %} is-active{% endif %}"
                  data-menu-trigger
                  aria-expanded="false"
                >
                  {{ link.title }}
                  <span class="nav__chevron">{%- render 'icon', name: 'chevron-down', size: 9 -%}</span>
                </button>

                {%- if is_mega or feature_image -%}
                  {%- render 'mega-menu',
                    link: link,
                    feature_image: feature_image,
                    feature_heading: feature_heading,
                    feature_text: feature_text,
                    feature_url: feature_url
                  -%}
                {%- else -%}
                  <div class="dropdown" data-menu-panel>
                    {%- for child in link.links -%}
                      <a href="{{ child.url }}">{{ child.title }}</a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- else -%}
                <a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </nav>
      </div>

      {%- comment -%} Centre: brand. {%- endcomment -%}
      <div class="header__brand">
        {%- if request.page_type == 'index' -%}
          <h1 style="margin:0">
        {%- endif -%}
        <a class="header__logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 400 }}"
              srcset="{{ settings.logo | image_url: width: 260 }} 260w, {{ settings.logo | image_url: width: 520 }} 520w"
              width="{{ settings.logo.width }}"
              height="{{ settings.logo.height }}"
              alt="{{ shop.name | escape }}"
              fetchpriority="high"
            >
          {%- else -%}
            {{ settings.logo_wordmark | default: shop.name }}
          {%- endif -%}
        </a>
        {%- if request.page_type == 'index' -%}
          </h1>
        {%- endif -%}
      </div>

      {%- comment -%} Right: utilities. {%- endcomment -%}
      <div class="header__actions">
        <button
          type="button"
          class="icon-btn"
          data-dialog-open="search"
          aria-label="{{ 'general.accessibility.open_search' | t }}"
        >
          {%- render 'icon', name: 'search', size: 20 -%}
        </button>

        {%- if section.settings.show_wishlist -%}
          <a class="icon-btn header__action hide-mobile" href="{{ routes.search_url }}?q=&type=product" aria-label="{{ 'sections.header.wishlist' | t }}">
            {%- render 'icon', name: 'heart', size: 20 -%}
            <span class="header__count" data-wishlist-count hidden>0</span>
          </a>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
          <a class="icon-btn hide-mobile" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}">
            {%- render 'icon', name: 'user', size: 20 -%}
          </a>
        {%- endif -%}

        <a
          class="icon-btn header__action"
          href="{{ routes.cart_url }}"
          {% if settings.cart_type == 'drawer' %}data-dialog-open="cart-drawer"{% endif %}
          aria-label="{{ 'general.accessibility.open_cart' | t }}"
        >
          {%- render 'icon', name: 'cart', size: 20 -%}
          <span
            class="header__count"
            data-cart-section="cart-count"
            {% if cart.item_count == 0 %}hidden{% endif %}
          >{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </header>
</site-header>

{%- comment -%}
  Mobile navigation: a bottom sheet on phones, a side panel on tablets.
  Sub-menus expand in place rather than pushing to a second screen, which
  keeps the shopper's place in the hierarchy.
{%- endcomment -%}
<div class="overlay" data-dialog-overlay></div>

<mobile-nav class="drawer drawer--left hide-desktop" id="mobile-menu" data-dialog-panel role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
  <div class="drawer__head">
    <span class="label">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="icon-btn" data-dialog-close data-dialog-focus>
      <span class="visually-hidden">{{ 'general.accessibility.close_menu' | t }}</span>
      {%- render 'icon', name: 'close', size: 18 -%}
    </button>
  </div>

  <div class="drawer__body">
    <ul class="mobile-nav list-unstyled" role="list">
      {%- for link in menu.links -%}
        <li class="mobile-nav__item">
          {%- if link.links.size > 0 -%}
            <button type="button" class="mobile-nav__toggle" aria-expanded="false">
              {{ link.title }}
              {%- render 'icon', name: 'plus', size: 14 -%}
            </button>
            <div class="mobile-nav__panel">
              <div>
                <div class="mobile-nav__sub">
                  <a href="{{ link.url }}">{{ 'collections.general.all_products' | t }}</a>
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      <span class="label mobile-nav__sub-title">{{ child.title }}</span>
                      {%- for grandchild in child.links -%}
                        <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {%- endfor -%}
                    {%- else -%}
                      <a href="{{ child.url }}">{{ child.title }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="mobile-nav__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a class="btn btn--secondary btn--full" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
      {%- endif -%}
      {%- render 'social-icons' -%}
    </div>
  </div>
</mobile-nav>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparent over the homepage hero",
      "info": "Use with a full-bleed hero that has a dark image.",
      "default": false
    },
    { "type": "checkbox", "id": "show_account", "label": "Show account link", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist link", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_feature",
      "name": "Mega menu image",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu item",
          "info": "Type the top-level menu item exactly as it appears in your menu, e.g. Shop."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
