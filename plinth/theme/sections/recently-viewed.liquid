{%- comment -%}
  Recently viewed.

  The browser remembers which products were opened; Shopify renders the cards
  through its search endpoint, so prices and availability are never stale.
{%- endcomment -%}

<recently-viewed
  class="section section--tight"
  data-section-id="{{ section.id }}"
  data-exclude-id="{{ product.id }}"
  data-limit="{{ section.settings.count }}"
  hidden
>
  <div class="page-wrap">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
    <div class="ledger ledger--4" data-recently-viewed-results>
      {%- if search.performed -%}
        {%- for item in search.results -%}
          <div>{%- render 'product-card', product: item -%}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</recently-viewed>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your history" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "count", "min": 2, "max": 8, "step": 1, "label": "Products shown", "default": 4 }
  ]
}
{% endschema %}
